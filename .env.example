# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). .env.local is already gitignored
# (see .gitignore's "env files" section) — never commit real keys.

# Project URL, e.g. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon/public key — safe to expose to the browser, access is bounded by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — server-side ONLY (migrations, admin/seed scripts).
# Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_, never import it into
# any client component.
SUPABASE_SERVICE_ROLE_KEY=
